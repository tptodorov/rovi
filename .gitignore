__pycache__
/.direnv/
/experiments/*/target/
~*.lck

# third-party skills, restored from skills-lock.json (task worktree:prepare)
/.claude/skills
/.agents/
/.task/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
/experiments/*/firmware/target/
/experiments/*/sim/*/target/

# bench runs: sim runs are throwaway; raw camera frames are never committed (they show the room)
/experiments/*/bench/sim-*/
/experiments/*/bench/*/cam/frames/
